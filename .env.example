# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string. Used to hash OTP codes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me
# Protects /api/cron/* (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me
# Phone of the salon owner. Whoever signs in with this number becomes the OWNER (also used by the local seed).
OWNER_PHONE=+919999999999

# ── Database ────────────────────────────────────────
# Leave empty in local dev → embedded Postgres (PGlite) stored in ./.data/pglite
# Netlify: leave empty — the hosted database sets NETLIFY_DB_URL automatically.
# Elsewhere: a real Postgres URL (Supabase / Neon / RDS)
DATABASE_URL=

# ── Firebase Phone Auth (login codes by SMS, no DLT needed) ──
# From Firebase console → Project settings → Your apps → Web app. These are public values.
# When set, the login form sends codes through Google; MSG91/staging/dev codes are not used.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── SMS OTP (MSG91) — alternative to Firebase, needs DLT ──
# Leave empty in dev → OTP is printed in the server console and shown on the login screen.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Preview/staging only, while MSG91 isn't set up: a secret 6-digit code that works for any number.
# Remove it once SMS is live.
STAGING_OTP_CODE=

# ── WhatsApp Cloud API ──────────────────────────────
# Leave empty in dev → messages are logged to the console and saved in the notifications table.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
