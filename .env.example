# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string. Used to hash OTP codes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me
# Protects /api/cron/* (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me
# Phone of the salon owner. The seed script makes this number the OWNER account.
OWNER_PHONE=+919999999999

# ── Database ────────────────────────────────────────
# Leave empty in local dev → embedded Postgres (PGlite) stored in ./.data/pglite
# Production: a real Postgres URL (Supabase / Neon / RDS)
DATABASE_URL=

# ── File storage ────────────────────────────────────
# Local folder for uploaded photos (gallery + inspiration). Needs a persistent disk in production.
STORAGE_DIR=./storage

# ── SMS OTP (MSG91) ─────────────────────────────────
# Leave empty in dev → OTP is printed in the server console and shown on the login screen.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── WhatsApp Cloud API ──────────────────────────────
# Leave empty in dev → messages are logged to the console and saved in the notifications table.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
